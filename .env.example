# Postgres. The default matches docker-compose.yml (docker compose up -d).
DATABASE_URL=postgres://contracts:contracts@localhost:5433/contracts

# Any OpenAI-compatible chat API. Groq shown; OpenRouter, OpenAI, Gemini or a local server work too.
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b
# Optional: a separate model for full-scan batches. On Groq each model has its own rate limit.
LLM_SCAN_MODEL=openai/gpt-oss-20b
# Optional, for reasoning models such as gpt-oss: low, medium or high.
LLM_REASONING_EFFORT=low
# The account's tokens-per-minute limit (Groq free tier: 8000). 0 = no limit.
# Requests are sized and paced to stay under it.
LLM_TPM=8000

# Optional: Deepgram speech-to-text for voice questions. The microphone button is hidden without it.
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3


MAX_UPLOAD_MB=25
AGENT_MAX_ROUNDS=8
SCAN_CONCURRENCY=4
